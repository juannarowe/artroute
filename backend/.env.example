# Copy this file to .env and fill in the values. Never commit .env.

# MongoDB Atlas connection string (Atlas → Connect → Drivers).
# Add the database name "artroute" after ".mongodb.net/".
MONGODB_URI=

# Port the API listens on (defaults to 3000)
PORT=3000

# Frontend URL allowed by CORS
FRONTEND_URL=http://localhost:5173

# Firebase project id (same as VITE_FIREBASE_PROJECT_ID in the frontend)
FIREBASE_PROJECT_ID=
# Google Gemini API key (free tier, aistudio.google.com) for the ArtBarcelona import.
# Without it, the import skips every event (Gemini is what reads the address).
GEMINI_API_KEY=
# Gemini model (optional)
GEMINI_MODEL=gemini-flash-lite-latest
